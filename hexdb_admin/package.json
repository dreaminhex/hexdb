  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force ./dist, ./.vite, ./.output, ./.turbo, ./.tmp, ./node_modules/.cache, ./node_modules/.vite, ./*.tsbuildinfo -ErrorAction SilentlyContinue\"",
    "clean:all": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force ./dist, ./.vite, ./.output, ./.turbo, ./.tmp, ./node_modules, ./package-lock.json, ./*.tsbuildinfo -ErrorAction SilentlyContinue\"",
    "ts:clean": "tsc --build --clean",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
