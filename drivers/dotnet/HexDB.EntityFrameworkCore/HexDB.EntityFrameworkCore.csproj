<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>HexDB.EntityFrameworkCore</PackageId>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>Dream In Hex</Authors>
    <Company>Dream In Hex</Company>
    <PackageProjectUrl>https://hexdb-website.vercel.app</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dreaminhex/hexdb</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Description>Entity Framework Core provider for HexDB: LINQ queries translated to HexDB's filters, sorting and paging; SaveChanges as one atomic HexDB transaction.</Description>
    <PackageTags>hexdb;efcore;entityframeworkcore;database;document;nosql</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- EF1001: providers build on EF Core's provider-facing ("internal") APIs, as every provider does. -->
    <NoWarn>$(NoWarn);CS1591;EF1001</NoWarn>
    <RootNamespace>HexDB.EntityFrameworkCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HexDB.Client\HexDB.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
